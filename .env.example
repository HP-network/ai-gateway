# Copy this file to .env and run: docker compose up --build

# Enable one or more providers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# For a local Ollama instance, set a model. The default URL is localhost:11434.
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional gateway authentication.
# AI_GATEWAY_API_KEY=change-me
# AI_GATEWAY_PORT=8080
