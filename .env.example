# Copy this file to .env, put one upstream key in it, then run `ai-gateway`.
# The three AI_GATEWAY_UPSTREAM_* values work with OpenAI, OpenRouter, DeepSeek,
# SiliconFlow, and most OpenAI-compatible APIs.

AI_GATEWAY_UPSTREAM_API_KEY=
AI_GATEWAY_UPSTREAM_BASE_URL=https://api.openai.com/v1
AI_GATEWAY_UPSTREAM_MODEL=gpt-4o-mini
# AI_GATEWAY_UPSTREAM_NAME=primary
# AI_GATEWAY_UPSTREAM_KIND=openai-compatible

# Optional additional providers. They are enabled when their key is present.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Local only: `ollama pull llama3.2`, then uncomment these two lines.
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Set both before exposing Docker or a non-loopback host.
# AI_GATEWAY_API_KEY=change-me
# AI_GATEWAY_ADMIN_API_KEY=admin-change-me
# AI_GATEWAY_PORT=8080
# AI_GATEWAY_RATE_LIMIT=120
# AI_GATEWAY_DATABASE=ai-gateway.db
