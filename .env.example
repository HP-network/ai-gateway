# One upstream is enough to start. Set a preset and its key.
AI_GATEWAY_UPSTREAM_PROVIDER=openai
AI_GATEWAY_UPSTREAM_API_KEY=
# Optional overrides:
# AI_GATEWAY_UPSTREAM_BASE_URL=https://api.openai.com/v1
# AI_GATEWAY_UPSTREAM_MODEL=gpt-4o-mini
# AI_GATEWAY_UPSTREAM_KIND=openai-compatible
# AI_GATEWAY_UPSTREAM_NAME=primary

# Local access keys. Leave blank for an unauthenticated localhost demo, or set
# both before exposing the service to another host. `ai-gateway init` generates
# random values for these automatically.
AI_GATEWAY_API_KEY=
AI_GATEWAY_ADMIN_API_KEY=

# Server defaults are safe for local use.
# AI_GATEWAY_HOST=127.0.0.1
# AI_GATEWAY_PORT=8080
# AI_GATEWAY_DATABASE=ai-gateway.db
# AI_GATEWAY_RATE_LIMIT=120
# AI_GATEWAY_TIMEOUT=45
# AI_GATEWAY_AUDIT_RETENTION_DAYS=30

# Optional extra auto-discovered providers.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434
