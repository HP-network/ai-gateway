{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "api_key_env": "AI_GATEWAY_API_KEY",
    "admin_api_key_env": "AI_GATEWAY_ADMIN_API_KEY",
    "database_path": "ai-gateway.db",
    "rate_limit_per_minute": 120,
    "request_timeout_seconds": 45
  },
  "routing": {
    "default_model": "auto",
    "max_retries": 2,
    "failure_cooldown_seconds": 30,
    "model_aliases": {
      "fast": "gpt-4o-mini",
      "local": "llama3.2"
    },
    "task_routes": {
      "code": ["openai", "local-ollama"],
      "chat": ["anthropic", "openai"]
    }
  },
  "providers": [
    {
      "name": "openai",
      "kind": "openai-compatible",
      "base_url": "https://api.openai.com/v1",
      "model": "gpt-4o-mini",
      "api_key_env": "OPENAI_API_KEY",
      "priority": 20,
      "max_concurrency": 64
    },
    {
      "name": "anthropic",
      "kind": "anthropic",
      "base_url": "https://api.anthropic.com",
      "model": "claude-3-5-haiku-latest",
      "api_key_env": "ANTHROPIC_API_KEY",
      "priority": 10,
      "max_concurrency": 32
    },
    {
      "name": "local-ollama",
      "kind": "ollama",
      "base_url": "http://127.0.0.1:11434",
      "model": "llama3.2",
      "priority": 5,
      "max_concurrency": 8
    }
  ]
}
